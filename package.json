{
  "name": "travelhub",
  "version": "0.4.3",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:bump": "bash scripts/version.sh patch",
    "version:minor": "bash scripts/version.sh minor",
    "version:major": "bash scripts/version.sh major",
    "version:list": "bash scripts/version.sh list",
    "version:rollback": "bash scripts/version.sh rollback",
    "version:changelog": "bash scripts/version.sh changelog",
    "check:i18n": "tsx scripts/check-i18n-keys.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@stripe/stripe-js": "^9.12.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "jose": "^5.9.6",
    "leaflet": "^1.9.4",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "pg": "^8.22.0",
    "prisma": "^6.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
