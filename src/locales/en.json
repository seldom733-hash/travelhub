  "faq": {
    "title": "❓ Frequently Asked Questions",
    "subtitle": "Couldn't find an answer? Contact our support",
    "noAnswer": "Couldn't find an answer?",
    "noAnswerDesc": "Our support is available 24/7 and ready to help you",
    "chatButton": "💬 Chat with us",
    "emailButton": "📧 Email",
    "categories": {
      "general": "General",
      "booking": "Booking",
      "payment": "Payment",
      "cancellation": "Cancellation",
      "account": "Account",
      "partner": "Partners"
    },
    "data": {
      "general": [
        {
          "q": "What is TravelHub?",
          "a": "TravelHub is a unified travel platform where you can find and book tours, hotels, flights, excursions, guides, photographers, and other travel services."
        },
        {
          "q": "Is TravelHub safe to use?",
          "a": "Yes! We use data encryption and secure payments. Funds are reserved and transferred to the seller only after the service is provided."
        },
        {
          "q": "How to contact support?",
          "a": "You can email us at info@travelhub.az, call +994 XX XXX XX XX, or message us on Telegram @travelhub."
        }
      ],
      "booking": [
        {
          "q": "How to book a service?",
          "a": "Select a service, specify dates and number of travelers, add to cart and place an order. You'll receive a confirmation via email."
        },
        {
          "q": "Can I book multiple services at once?",
          "a": "Yes! Use the trip builder or add different services to your cart. They will all be processed in one order."
        },
        {
          "q": "How to get a booking confirmation?",
          "a": "After payment, you'll receive an email with confirmation and booking details. The information is also available in your dashboard."
        }
      ],
      "payment": [
        {
          "q": "What payment methods are available?",
          "a": "We accept bank cards (Visa, MasterCard), Apple Pay, Google Pay. Payments are encrypted."
        },
        {
          "q": "Can I pay in installments?",
          "a": "Yes, installment plans are available for some services. Check details during booking."
        },
        {
          "q": "What currency is used?",
          "a": "The main currency is AZN. USD, EUR, and RUB are also available with automatic conversion."
        }
      ],
      "cancellation": [
        {
          "q": "Can I cancel a booking?",
          "a": "Yes, the cancellation policy depends on the service. Many services allow free cancellation up to 48 hours before start."
        },
        {
          "q": "How to get a refund?",
          "a": "Upon cancellation, the refund is processed to your card within 5-10 business days."
        },
        {
          "q": "What if the service doesn't match the description?",
          "a": "Contact our support within 24 hours after the service is provided. We'll investigate and help resolve the issue."
        }
      ],
      "account": [
        {
          "q": "How to create an account?",
          "a": "Click 'Sign up', choose a role (buyer or partner), fill in your details and confirm your email."
        },
        {
          "q": "How to change my password?",
          "a": "Go to Settings → Security → Change password. Or use 'Forgot password' on the login page."
        },
        {
          "q": "Can I delete my account?",
          "a": "Yes, go to Settings → Account → Delete account. Note that this action is irreversible."
        }
      ],
      "partner": [
        {
          "q": "How to become a partner?",
          "a": "Click 'Become a partner', choose a partnership type, fill in the form and wait for moderation."
        },
        {
          "q": "What is the platform commission?",
          "a": "The commission ranges from 5% to 15% depending on the service type and sales volume."
        },
        {
          "q": "How to receive payouts?",
          "a": "Payouts are processed weekly to your bank account. The minimum payout amount is 100 AZN."
        }
      ]
    }
  },
  "terms": {
    "title": "📜 Terms of Service",
    "lastUpdated": "Last updated: July 24, 2024",
    "sections": [
      {
        "heading": "1. Acceptance of Terms",
        "text": "By using the TravelHub platform, you agree to these terms. If you do not agree with any of the terms, please do not use our service."
      },
      {
        "heading": "2. Registration",
        "text": "To use certain features, you must register an account. You are responsible for the confidentiality of your account."
      },
      {
        "heading": "3. Booking",
        "text": "When booking, you enter into a contract directly with the service provider. TravelHub acts as an intermediary for payment processing. Prices are listed in AZN and may change."
      },
      {
        "heading": "4. Payment and Refunds",
        "text": "Payment is processed through secure payment gateways. The refund policy depends on the specific service and provider."
      },
      {
        "heading": "5. Liability",
        "text": "TravelHub is not responsible for the quality of services provided by sellers. We provide a platform for buyer-seller interaction."
      },
      {
        "heading": "6. Intellectual Property",
        "text": "All materials on the platform are copyrighted and owned by TravelHub."
      },
      {
        "heading": "7. Dispute Resolution",
        "text": "All disputes are resolved through negotiation. If no agreement is reached, disputes are submitted to the court at TravelHub's location."
      }
    ]
  },
  "privacy": {
    "title": "🔒 Privacy Policy",
    "lastUpdated": "Last updated: July 24, 2024",
    "sections": [
      {
        "heading": "1. Information Collection",
        "text": "We collect information you provide directly: registration data, booking and payment data, messages and reviews, settings."
      },
      {
        "heading": "2. Information Usage",
        "text": "We use your information to process bookings, improve the service, send notifications and ensure platform security."
      },
      {
        "heading": "3. Data Sharing",
        "text": "We do not sell your data to third parties. Data is shared with service providers only to fulfill bookings."
      },
      {
        "heading": "4. Security",
        "text": "We use SSL/TLS encryption, secure data storage, and regular security checks."
      },
      {
        "heading": "5. Your Rights",
        "text": "You have the right to: access your data, correct inaccurate data, delete your account, unsubscribe from newsletters."
      },
      {
        "heading": "6. Cookies",
        "text": "We use cookies to improve user experience, analytics, and content personalization."
      },
      {
        "heading": "7. Contact",
        "text": "For privacy questions: privacy@travelhub.az"
      }
    ]
  },
